 void Npc::updateAnimation(uint64_t dt, bool force) {
+#ifdef OPENGOTHIC_TOUCH_UI
+  // poses are computed from absolute time: distant characters can skip frames safely
+  if(!force && !isPlayer() && aiPolicy>=NpcProcessPolicy::AiFar) {
+    const uint32_t period = aiPolicy==NpcProcessPolicy::AiFar ? 3u : 12u;
+    if((animLodCounter++ + uint32_t(hnpc->id))%period!=0)
+      return;
+    }
+#endif
   if(auto* effects = owner.globalFx())
     visual.pose().setTimeScale(effects->modelTimeScale(*this),owner.tickCount());
   const auto camera = Gothic::inst().camera();
